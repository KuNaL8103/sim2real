# Virtual environments (core, ROS, ML)
.venv*/
venv/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/

# Colcon / ROS build outputs
build/
install/
log/

# Local data: datasets, rollouts, exports (keep the directory, ignore contents)
data/**
!data/.gitkeep

# Fetched simulator assets: meshes are large and restored by scripts/fetch_assets.sh.
# The MJCF XML, upstream LICENSE, and ATTRIBUTION.md are committed.
assets/mujoco/franka_emika_panda/assets/
assets/mujoco/franka_emika_panda/panda.png

# Model weights and checkpoints
*.pt
*.pth
*.safetensors
*.ckpt

# Numpy arrays are ignored except explicit test fixtures
*.npz
!tests/fixtures/*.npz
!tests/fixtures/**/*.npz

# Experiment tracking and generated outputs
wandb/
mlruns/
.hydra/
outputs/

# Secrets and local config
.env
.env.*

# ROS bag / recording files
*.bag
*.mcap

# Editor and OS noise
.vscode/
.idea/
.DS_Store
