Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.2
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Overhead color
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/overhead/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Wrist color
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/wrist/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Camera
      Enabled: true
      Name: Overhead camera
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/overhead/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Camera
      Enabled: true
      Name: Wrist camera
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/wrist/color/image_raw
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Workspace pointcloud
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /workspace/pointcloud
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: TSDF mesh
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /workspace/tsdf_mesh
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.45
        Y: 0.0
        Z: 0.45
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: world
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.6
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
  X: 60
  Y: 60
