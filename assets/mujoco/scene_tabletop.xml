<mujoco model="sim2real tabletop">
  <!-- Franka Emika Panda from MuJoCo Menagerie, pinned commit recorded in
       ATTRIBUTION.md. The backend adds the wrist camera to the hand body with
       MjSpec so the upstream MJCF stays unmodified. -->
  <include file="franka_emika_panda/panda.xml"/>

  <!-- The included MJCF declares meshdir="assets" relative to its own folder;
       this override keeps the meshes under franka_emika_panda/assets. -->
  <compiler angle="radian" meshdir="franka_emika_panda/assets" autolimits="true"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="256" offheight="256"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.30 0.45 0.60" rgb2="0.05 0.05 0.08"
      width="256" height="256"/>
    <texture type="2d" name="table_tex" builtin="checker" mark="edge"
      rgb1="0.55 0.45 0.35" rgb2="0.45 0.36 0.28" markrgb="0.8 0.8 0.8"
      width="256" height="256"/>
    <material name="table_mat" texture="table_tex" texuniform="true" texrepeat="4 4"
      reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0.4 0.0 1.6" dir="0 0 -1" directional="true"
      diffuse="0.8 0.8 0.8"/>
    <light name="fill_light" pos="0.0 -0.6 1.0" dir="0.4 0.6 -1" diffuse="0.35 0.35 0.35"/>

    <geom name="table" type="box" size="0.35 0.35 0.02" pos="0.45 0.0 0.40"
      material="table_mat"/>

    <camera name="overhead_cam" pos="0.45 0.0 1.10" quat="1 0 0 0" fovy="55"/>

    <body name="cube_red" pos="0.45 -0.12 0.44">
      <freejoint name="cube_red_joint"/>
      <geom name="cube_red_geom" type="box" size="0.02 0.02 0.02" rgba="0.80 0.10 0.10 1"/>
    </body>
    <body name="cube_green" pos="0.45 0.00 0.44">
      <freejoint name="cube_green_joint"/>
      <geom name="cube_green_geom" type="box" size="0.02 0.02 0.02" rgba="0.10 0.70 0.15 1"/>
    </body>
    <body name="cube_blue" pos="0.45 0.12 0.44">
      <freejoint name="cube_blue_joint"/>
      <geom name="cube_blue_geom" type="box" size="0.02 0.02 0.02" rgba="0.10 0.20 0.85 1"/>
    </body>

    <geom name="zone_left" type="cylinder" size="0.055 0.001" pos="0.38 -0.22 0.421"
      rgba="0.95 0.85 0.10 0.55" contype="0" conaffinity="0"/>
    <geom name="zone_right" type="cylinder" size="0.055 0.001" pos="0.38 0.22 0.421"
      rgba="0.10 0.85 0.85 0.55" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
